{
  "name": "desktop-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Windows desktop pet built with Electron and TypeScript.",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "io.github.wbluuue.desktoppet",
    "productName": "DesktopPet",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/*.html",
      "src/renderer/*.css",
      "assets/pet/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DesktopPet",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
